# Dependencies are installed inside the image by the Dockerfile.
# Copying the host's node_modules over the Alpine-built ones breaks native modules.
node_modules

# Next.js build output is regenerated inside the image.
.next
out
build

# Secrets: supplied at runtime via env_file. Never bake them into the image.
.env
.env.*

# VCS and editor cruft.
.git
.gitignore
.idea
.vscode
.DS_Store

# Test / debug artifacts.
coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
